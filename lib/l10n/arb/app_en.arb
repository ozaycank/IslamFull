  "wuduGuideTitle": "How to perform Wudu?",
  "@wuduGuideTitle": { "description": "Title" },
  "wuduStep1Title": "1. Intention and Bismillah",
  "@wuduStep1Title": { "description": "Step" },
  "wuduStep1Desc": "Make intention for Wudu and say Bismillah.",
  "@wuduStep1Desc": { "description": "Step" },
  "wuduStep2Title": "2. Wash Hands",
  "@wuduStep2Title": { "description": "Step" },
  "wuduStep2Desc": "Wash hands up to the wrists three times, ensuring water reaches between fingers.",
  "@wuduStep2Desc": { "description": "Step" },
  "wuduStep3Title": "3. Rinse Mouth",
  "@wuduStep3Title": { "description": "Step" },
  "wuduStep3Desc": "Take water into the mouth with the right hand and rinse it three times.",
  "@wuduStep3Desc": { "description": "Step" },
  "wuduStep4Title": "4. Sniff Water into Nose",
  "@wuduStep4Title": { "description": "Step" },
  "wuduStep4Desc": "Inhale water into the nose with the right hand and blow it out using the left hand, three times.",
  "@wuduStep4Desc": { "description": "Step" },
  "wuduStep5Title": "5. Wash Face",
  "@wuduStep5Title": { "description": "Step" },
  "wuduStep5Desc": "Wash the whole face (from hairline to chin) three times.",
  "@wuduStep5Desc": { "description": "Step" },
  "wuduStep6Title": "6. Wash Arms",
  "@wuduStep6Title": { "description": "Step" },
  "wuduStep6Desc": "Wash the right arm up to the elbow three times, then do the same for the left arm.",
  "@wuduStep6Desc": { "description": "Step" },
  "wuduStep7Title": "7. Wipe Head (Masah)",
  "@wuduStep7Title": { "description": "Step" },
  "wuduStep7Desc": "Wipe the head once with wet hands. In Diyanet's Hanafi guidance, wiping at least one quarter of the head fulfills this requirement; details differ between schools of Islamic law.",
  "@wuduStep7Desc": { "description": "Step" },
  "wuduStep8Title": "8. Wipe Ears and Neck",
  "@wuduStep8Title": { "description": "Step" },
  "wuduStep8Desc": "Wipe the ears. Diyanet's commonly taught sequence also includes wiping the neck with the backs of the hands. Some details of this step vary between schools of Islamic law.",
  "@wuduStep8Desc": { "description": "Step" },
  "wuduStep9Title": "9. Wash Feet",
  "@wuduStep9Title": { "description": "Step" },
  "wuduStep9Desc": "Wash the right foot up to the ankles three times, starting from the toes. Repeat for the left foot.",
