"@duaSleepArabic": {
  "description": "Arabic text of the supplication before sleep"
},
"duaSleepTransliteration": "Bismika amutu wa ahya.",
"@duaSleepTransliteration": {
  "description": "Transliteration of the supplication before sleep"
},
"duaSleepMeaning": "In Your name I die and I live.",
"@duaSleepMeaning": {
  "description": "Meaning of the supplication before sleep"
},
"duaSleepSource": "Bukhari, Da'awat, 7",
"@duaSleepSource": {
  "description": "Hadith source for the supplication before sleep"
},

"duaLeavingHomeTitle": "Leaving Home",
"@duaLeavingHomeTitle": {
  "description": "Title for the supplication when leaving home"
},
"duaLeavingHomeWhen": "When leaving your home.",
"@duaLeavingHomeWhen": {
  "description": "Usage context for the leaving home supplication"
},
"duaLeavingHomeArabic": "بِسْمِ اللَّهِ، تَوَكَّلْتُ عَلَى اللَّهِ، لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ",
"@duaLeavingHomeArabic": {
  "description": "Arabic text of the supplication when leaving home"
},
"duaLeavingHomeTransliteration": "Bismillah, tawakkaltu 'alallah, la hawla wa la quwwata illa billah.",
"@duaLeavingHomeTransliteration": {
  "description": "Transliteration of the supplication when leaving home"
},
"duaLeavingHomeMeaning": "In the name of Allah; I place my trust in Allah. There is no power and no strength except through Allah.",
"@duaLeavingHomeMeaning": {
  "description": "Meaning of the supplication when leaving home"
},
"duaLeavingHomeSource": "Abu Dawud, Adab, 102-103",
"@duaLeavingHomeSource": {
  "description": "Hadith source for the supplication when leaving home"
},

"duaRestroomTitle": "Before Entering the Restroom",
"@duaRestroomTitle": {
  "description": "Title for the supplication before entering the restroom"
},
"duaRestroomWhen": "Before entering the restroom.",
"@duaRestroomWhen": {
  "description": "Usage context for the restroom supplication"
},
"duaRestroomArabic": "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْخُبُثِ وَالْخَبَائِثِ",
"@duaRestroomArabic": {
  "description": "Arabic text of the supplication before entering the restroom"
},
"duaRestroomTransliteration": "Allahumma inni a'udhu bika minal-khubthi wal-khaba'ith.",
"@duaRestroomTransliteration": {
  "description": "Transliteration of the supplication before entering the restroom"
},
"duaRestroomMeaning": "O Allah, I seek refuge in You from evil and impure things.",
"@duaRestroomMeaning": {
  "description": "Meaning of the supplication before entering the restroom"
},
"duaRestroomSource": "Bukhari, Wudu, 9",
"@duaRestroomSource": {
  "description": "Hadith source for the supplication before entering the restroom"
},

"duaAfterMealTitle": "After Eating",
"@duaAfterMealTitle": {
  "description": "Title for the supplication after eating"
},
"duaAfterMealWhen": "After eating or drinking.",
"@duaAfterMealWhen": {
  "description": "Usage context for the supplication after eating"
},
"duaAfterMealArabic": "الْحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنَا وَسَقَانَا وَجَعَلَنَا مِنَ الْمُسْلِمِينَ",
"@duaAfterMealArabic": {
  "description": "Arabic text of the supplication after eating"
},
"duaAfterMealTransliteration": "Al-hamdu lillahil-ladhi at'amana wa saqana wa ja'alana minal-muslimin.",
"@duaAfterMealTransliteration": {
  "description": "Transliteration of the supplication after eating"
},
"duaAfterMealMeaning": "All praise is for Allah who fed us, gave us drink, and made us among the Muslims.",
"@duaAfterMealMeaning": {
  "description": "Meaning of the supplication after eating"
},
"duaAfterMealSource": "Tirmidhi, Da'awat, 56",
"@duaAfterMealSource": {
  "description": "Hadith source for the supplication after eating"
},

"duaTravelTitle": "Travel",
"@duaTravelTitle": {
  "description": "Title for the travel supplication"
},
"duaTravelWhen": "When setting out on a journey.",
"@duaTravelWhen": {
  "description": "Usage context for the travel supplication"
},
"duaTravelArabic": "سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ وَإِنَّا إِلَى رَبِّنَا لَمُنْقَلِبُونَ اللَّهُمَّ إِنَّا نَسْأَلُكَ فِي سَفَرِنَا هَذَا الْبِرَّ وَالتَّقْوَى وَمِنَ الْعَمَلِ مَا تَرْضَى اللَّهُمَّ هَوِّنْ عَلَيْنَا سَفَرَنَا هَذَا وَاطْوِ عَنَّا بُعْدَهُ اللَّهُمَّ أَنْتَ الصَّاحِبُ فِي السَّفَرِ وَالْخَلِيفَةُ فِي الْأَهْلِ اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ وَعْثَاءِ السَّفَرِ وَكَآبَةِ الْمَنْظَرِ وَسُوءِ الْمُنْقَلَبِ فِي الْمَالِ وَالْأَهْلِ",
"@duaTravelArabic": {
  "description": "Arabic text of the travel supplication"
},
"duaTravelTransliteration": "Subhanalladhi sakhkhara lana hadha wa ma kunna lahu muqrinin, wa inna ila rabbina lamunqalibun. Allahumma inna nas'aluka fi safarina hadhal-birra wat-taqwa wa minal-'amali ma tarda. Allahumma hawwin 'alayna safarana hadha watwi 'anna bu'dahu. Allahumma antas-sahibu fis-safari wal-khalifatu fil-ahli. Allahumma inni a'udhu bika min wa'tha'is-safari wa ka'abatil-manzari wa su'il-munqalabi fil-mali wal-ahli.",
"@duaTravelTransliteration": {
  "description": "Transliteration of the travel supplication"
},
"duaTravelMeaning": "Glory is to the One who placed this at our service, though we could not have controlled it ourselves, and surely to our Lord we will return. O Allah, we ask You on this journey for righteousness, mindfulness of You, and deeds that please You. Make this journey easy for us and shorten its distance. You are our Companion on the journey and the Guardian of our family. I seek refuge in You from the hardship of travel, distressing sights, and an unhappy return to family and property.",
"@duaTravelMeaning": {
  "description": "Meaning of the travel supplication"
},
"duaTravelSource": "Muslim, Hajj, 425",
"@duaTravelSource": {
  "description": "Hadith source for the travel supplication"
},

"duaAfterPrayerDhikrTitle": "Remembrance After Prayer",
"@duaAfterPrayerDhikrTitle": {
  "description": "Title for recommended remembrance after prayer"
},
"duaAfterPrayerDhikrWhen": "After the obligatory prayer. This remembrance is recommended and is not part of the prayer itself.",
"@duaAfterPrayerDhikrWhen": {
  "description": "Usage and religious status note for remembrance after prayer"
},
"duaAfterPrayerDhikrArabic": "سُبْحَانَ اللَّهِ ×٣٣\nالْحَمْدُ لِلَّهِ ×٣٣\nاللَّهُ أَكْبَرُ ×٣٣\nلَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ",
"@duaAfterPrayerDhikrArabic": {
  "description": "Arabic text for recommended remembrance after prayer"
},
"duaAfterPrayerDhikrTransliteration": "Subhanallah ×33\nAlhamdulillah ×33\nAllahu Akbar ×33\nLa ilaha illallahu wahdahu la sharika lah, lahul-mulku wa lahul-hamdu wa huwa 'ala kulli shay'in qadir.",
"@duaAfterPrayerDhikrTransliteration": {
  "description": "Transliteration for recommended remembrance after prayer"
},
