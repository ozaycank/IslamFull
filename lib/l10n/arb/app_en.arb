"duaWakeTitle": "Upon Waking",
"@duaWakeTitle": {
  "description": "Title for the supplication upon waking"
},
"duaWakeWhen": "After waking from sleep.",
"@duaWakeWhen": {
  "description": "Usage context for the waking supplication"
},
"duaWakeArabic": "الْحَمْدُ لِلَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا وَإِلَيْهِ النُّشُورُ",
"@duaWakeArabic": {
  "description": "Arabic text of the supplication upon waking"
},
"duaWakeTransliteration": "Al-hamdu lillahil-ladhi ahyana ba'da ma amatana wa ilayhin-nushur.",
