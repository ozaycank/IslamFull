},

"hajjFundamentalsMenuDesc": "Learn the essential concepts of ihram, tawaf, sa'y, Arafat, Muzdalifah and Mina.",
"@hajjFundamentalsMenuDesc": {
  "description": "Navigation description for the Hajj fundamentals guide"
},

"hajjFundamentalsIntro": "This guide introduces the main places and acts encountered during Hajj. It is an orientation guide rather than a personalised ruling or a complete day-by-day Hajj programme.",
"@hajjFundamentalsIntro": {
  "description": "Introduction to the Hajj fundamentals guide"
},

"hajjFundamentalsTopicsTitle": "Essential Concepts",
"@hajjFundamentalsTopicsTitle": {
  "description": "Heading above Hajj fundamentals topics"
},

"hajjFundamentalsMeaningTitle": "Meaning and Obligation of Hajj",
"@hajjFundamentalsMeaningTitle": {
  "description": "Title of the Hajj meaning and obligation topic"
},

"hajjFundamentalsMeaningDesc": "Hajj is one of the five pillars of Islam and is required once in a lifetime from a Muslim who meets the religious conditions of ability. Its rites are performed in and around Makkah during the prescribed Hajj period.",
"@hajjFundamentalsMeaningDesc": {
  "description": "High-level explanation of Hajj and its obligation"
},

"hajjFundamentalsIhramTitle": "Ihram and Miqat",
"@hajjFundamentalsIhramTitle": {
  "description": "Title of the ihram and miqat topic"
},

"hajjFundamentalsIhramDesc": "Ihram is the state in which a person enters Hajj or Umrah by intention. Those travelling for Hajj or Umrah from outside the miqat boundaries enter ihram before crossing the relevant miqat. In Hanafi teaching, intention and talbiyah together form ihram; other schools differ in the legal status of the talbiyah.",
"@hajjFundamentalsIhramDesc": {
  "description": "High-level explanation of ihram and miqat with school differences"
},

"hajjFundamentalsTawafTitle": "Tawaf",
"@hajjFundamentalsTawafTitle": {
  "description": "Title of the tawaf topic"
},

"hajjFundamentalsTawafDesc": "Tawaf consists of seven circuits around the Ka'bah, beginning from the line of the Black Stone with the Ka'bah kept to the left. Hajj contains different types of tawaf; the visitation or ifadah tawaf is a pillar of Hajj.",
"@hajjFundamentalsTawafDesc": {
  "description": "High-level explanation of tawaf in Hajj"
},

"hajjFundamentalsSayTitle": "Sa'y",
"@hajjFundamentalsSayTitle": {
  "description": "Title of the sa'y topic"
},

"hajjFundamentalsSayDesc": "Sa'y is performed between Safa and Marwah in seven traversals, beginning at Safa and ending at Marwah. Its detailed legal classification and some conditions differ between schools of law.",
"@hajjFundamentalsSayDesc": {
  "description": "High-level explanation of sa'y"
},

"hajjFundamentalsArafatTitle": "Arafat",
"@hajjFundamentalsArafatTitle": {
  "description": "Title of the Arafat topic"
},

"hajjFundamentalsArafatDesc": "Standing at Arafat within its valid time is a pillar of Hajj. Missing the valid Arafat standing means that the Hajj cannot be completed for that year.",
"@hajjFundamentalsArafatDesc": {
  "description": "Explanation of the importance of the standing at Arafat"
},

"hajjFundamentalsMuzdalifahTitle": "Muzdalifah",
"@hajjFundamentalsMuzdalifahTitle": {
  "description": "Title of the Muzdalifah topic"
},

"hajjFundamentalsMuzdalifahDesc": "After Arafat, pilgrims proceed to Muzdalifah as part of the Hajj rites. The legal ruling and precise valid period for the Muzdalifah standing contain differences between schools of law, especially regarding the minimum time required.",
"@hajjFundamentalsMuzdalifahDesc": {
  "description": "High-level explanation of Muzdalifah while acknowledging school differences"
},

"hajjFundamentalsMinaTitle": "Mina and the Jamarat",
"@hajjFundamentalsMinaTitle": {
  "description": "Title of the Mina and Jamarat topic"
},

"hajjFundamentalsMinaDesc": "Mina is central to several rites of the Hajj days, including the stoning of the Jamarat. The timing, order and detailed rulings of these rites depend on the day, type of Hajj and school of law.",
"@hajjFundamentalsMinaDesc": {
  "description": "High-level explanation of Mina and the Jamarat"
},

"hajjFundamentalsReleaseTitle": "Haircut and Leaving Ihram",
"@hajjFundamentalsReleaseTitle": {
  "description": "Title of the Hajj haircut and release from ihram topic"
},

"hajjFundamentalsReleaseDesc": "At the appropriate stage of Hajj, shaving or shortening the hair forms part of leaving the restrictions of ihram. The exact sequence with sacrifice, stoning and tawaf, and the legal consequences of changing that sequence, differ in detail between schools of law.",
"@hajjFundamentalsReleaseDesc": {
  "description": "High-level explanation of haircut and release from ihram"
},

"hajjFundamentalsSchoolNote": "This screen introduces shared Hajj concepts. The exact sequence and legal details vary according to the type of Hajj, school of law and personal circumstances. A day-by-day guide and the types of Hajj are handled separately.",
"@hajjFundamentalsSchoolNote": {
  "description": "Scope and school-of-law disclaimer for Hajj fundamentals"
},

"hajjUmrahSourceNote": "Religious guidance is based primarily on information published by the Presidency of Religious Affairs and the High Board of Religious Affairs.",
"@hajjUmrahSourceNote": {
  "description": "Source note shared by Hajj and Umrah guides"
},

"umrahGuideTitle": "Umrah Guide",
"@umrahGuideTitle": {
  "description": "Title of the Umrah guide"
},

"umrahGuideMenuDesc": "Learn the basic sequence of ihram, tawaf, sa'y and leaving ihram.",
"@umrahGuideMenuDesc": {
  "description": "Navigation description for the Umrah guide"
},

"umrahGuideIntro": "Umrah is performed through a concise sequence centred on ihram, tawaf, sa'y and leaving ihram. This guide explains that shared basic flow without treating school-specific details as universal.",
"@umrahGuideIntro": {
  "description": "Introduction to the Umrah guide"
},

"umrahGuideStepsTitle": "Basic Umrah Sequence",
"@umrahGuideStepsTitle": {
  "description": "Heading above the Umrah steps"
},

"umrahGuideStep1Title": "1. Enter Ihram",
"@umrahGuideStep1Title": {
  "description": "Title of the first Umrah step"
},

"umrahGuideStep1Desc": "Enter ihram for Umrah before crossing the relevant miqat. Ihram is a state of worship entered by intention, not merely the wearing of ihram clothing. Details concerning talbiyah and some ihram rules differ between schools of law.",
"@umrahGuideStep1Desc": {
  "description": "Description of entering ihram for Umrah"
},

"umrahGuideStep2Title": "2. Perform Tawaf",
"@umrahGuideStep2Title": {
  "description": "Title of the second Umrah step"
},

"umrahGuideStep2Desc": "Perform the Umrah tawaf around the Ka'bah in seven circuits. Tawaf is an essential part of Umrah according to all schools of law.",
"@umrahGuideStep2Desc": {
  "description": "Description of Umrah tawaf"
},

"umrahGuideStep3Title": "3. Perform Sa'y",
"@umrahGuideStep3Title": {
  "description": "Title of the third Umrah step"
},

"umrahGuideStep3Desc": "Perform seven traversals between Safa and Marwah: four journeys from Safa to Marwah and three from Marwah to Safa, finishing at Marwah. The detailed legal classification of sa'y differs between schools of law.",
"@umrahGuideStep3Desc": {
  "description": "Description of Umrah sa'y"
},

"umrahGuideStep4Title": "4. Cut the Hair and Leave Ihram",
"@umrahGuideStep4Title": {
  "description": "Title of the fourth Umrah step"
},

"umrahGuideStep4Desc": "After completing the Umrah rites, the hair is shaved or shortened as applicable and the person leaves the state of ihram. The amount and detailed rules differ according to circumstances and school of law.",
"@umrahGuideStep4Desc": {
  "description": "Description of leaving ihram after Umrah"
},

"umrahGuideSchoolNote": "This is a basic learning sequence, not an individual fatwa. Questions involving missed rites, illness, menstruation, miqat mistakes, penalties or other exceptional circumstances require more specific guidance.",
"@umrahGuideSchoolNote": {
  "description": "Scope and religious-guidance disclaimer for the Umrah guide"
},
"hajjTypesTitle": "Types of Hajj",
"@hajjTypesTitle": {
  "description": "Title of the Hajj types guide"
},

"hajjTypesMenuDesc": "Compare Ifrad, Tamattu and Qiran and understand their basic differences.",
"@hajjTypesMenuDesc": {
  "description": "Navigation description for the Hajj types guide"
},

"hajjTypesIntro": "Hajj can be performed as Ifrad, Tamattu or Qiran. The main differences concern whether Umrah is combined with Hajj, whether ihram is exited between them, and whether a thanksgiving sacrifice is required.",
"@hajjTypesIntro": {
  "description": "Introduction to the three types of Hajj"
},

"hajjTypesThreeTitle": "The Three Types",
"@hajjTypesThreeTitle": {
  "description": "Heading above the three Hajj types"
},

"hajjTypeIfradTitle": "Ifrad",
"@hajjTypeIfradTitle": {
  "description": "Title of the Ifrad Hajj type"
},

"hajjTypeIfradDesc": "Ifrad is Hajj performed without performing Umrah as part of the same Hajj season. The pilgrim enters ihram with the intention of Hajj and remains in ihram through the relevant Hajj rites. A thanksgiving sacrifice is not required merely because the Hajj is Ifrad.",
"@hajjTypeIfradDesc": {
  "description": "Explanation of Ifrad Hajj"
},

"hajjTypeTamattuTitle": "Tamattu",
"@hajjTypeTamattuTitle": {
  "description": "Title of the Tamattu Hajj type"
},

"hajjTypeTamattuDesc": "In Tamattu, the pilgrim first enters ihram for Umrah during the Hajj season, completes Umrah and leaves ihram. Before Arafat, the pilgrim enters ihram again for Hajj. A thanksgiving sacrifice is required for Tamattu according to the applicable rules.",
"@hajjTypeTamattuDesc": {
  "description": "Explanation of Tamattu Hajj"
},

"hajjTypeQiranTitle": "Qiran",
"@hajjTypeQiranTitle": {
  "description": "Title of the Qiran Hajj type"
},

"hajjTypeQiranDesc": "In Qiran, Hajj and Umrah are intended together and performed within one continuous state of ihram. After completing the Umrah rites, the pilgrim does not leave ihram before continuing with Hajj. A thanksgiving sacrifice is required for Qiran according to the applicable rules.",
"@hajjTypeQiranDesc": {
  "description": "Explanation of Qiran Hajj"
},

"hajjTypesNote": "The three types share the central rites of Hajj but differ in intention, ihram and the relationship between Hajj and Umrah. Changing from one type to another and exceptional situations have detailed school-specific rulings; follow qualified guidance for your actual Hajj.",
"@hajjTypesNote": {
  "description": "Disclaimer for the Hajj types guide"
},

"hajjDaysTitle": "Hajj Days",
"@hajjDaysTitle": {
  "description": "Title of the day-by-day Hajj guide"
},

"hajjDaysMenuDesc": "Follow a concise overview of the main rites from 8 through 13 Dhul Hijjah.",
"@hajjDaysMenuDesc": {
  "description": "Navigation description for the Hajj days guide"
},

"hajjDaysIntro": "This screen gives a learning overview of the main Hajj days. It is not a live itinerary: exact movement times, concessions and the order of some rites can differ by school of law, Hajj type, health, crowd conditions and official organisation instructions.",
"@hajjDaysIntro": {
  "description": "Introduction to the day-by-day Hajj guide"
},

"hajjDaysFlowTitle": "Main Hajj Flow",
"@hajjDaysFlowTitle": {
  "description": "Heading above the day-by-day Hajj sequence"
},

"hajjDay8Title": "8 Dhul Hijjah · Tarwiyah",
"@hajjDay8Title": {
  "description": "Title for 8 Dhul Hijjah in the Hajj guide"
},

"hajjDay8Desc": "Those performing Tamattu enter ihram again for Hajj on this day or earlier if they have not already done so. In the established Hajj sequence, pilgrims prepare for the days of Hajj and proceed toward Mina before Arafat.",
"@hajjDay8Desc": {
  "description": "Learning summary for 8 Dhul Hijjah"
},

"hajjDay9Title": "9 Dhul Hijjah · Arafah",
"@hajjDay9Title": {
  "description": "Title for the Day of Arafah in the Hajj guide"
},

"hajjDay9Desc": "The standing at Arafat is a pillar of Hajj and must occur within its valid period. After Arafat, pilgrims proceed to Muzdalifah, where the Muzdalifah standing forms part of the Hajj rites. Detailed timing rules differ between schools of law.",
"@hajjDay9Desc": {
  "description": "Learning summary for 9 Dhul Hijjah"
},

"hajjDay10Title": "10 Dhul Hijjah · First Day of Eid",
"@hajjDay10Title": {
  "description": "Title for 10 Dhul Hijjah in the Hajj guide"
},

"hajjDay10Desc": "The common sequence includes stoning the Aqabah Jamarah, the thanksgiving sacrifice for those performing Tamattu or Qiran, shaving or shortening the hair and the visitation tawaf. The legal status of this order differs between schools of law; the current Presidency of Religious Affairs fatwa and practice allow flexibility in the sequence without treating every change of order as requiring a penalty.",
"@hajjDay10Desc": {
  "description": "Learning summary for 10 Dhul Hijjah with school differences"
},

"hajjDays11And12Title": "11–12 Dhul Hijjah · Days of Tashriq",
"@hajjDays11And12Title": {
  "description": "Title for 11 and 12 Dhul Hijjah in the Hajj guide"
},

"hajjDays11And12Desc": "These are Mina and Jamarat days. The three Jamarat are stoned as part of the Hajj rites. Detailed valid times and concessions can differ, especially in cases involving crowding, illness or inability.",
"@hajjDays11And12Desc": {
  "description": "Learning summary for 11 and 12 Dhul Hijjah"
},

"hajjDay13Title": "13 Dhul Hijjah · Final Tashriq Day",
"@hajjDay13Title": {
  "description": "Title for 13 Dhul Hijjah in the Hajj guide"
},

"hajjDay13Desc": "Some pilgrims will have completed their Mina duties earlier, while those remaining in Mina can have further Jamarat duties on the fourth day of Eid. The point at which this duty applies differs between schools of law, so this screen does not make an automatic personal ruling.",
"@hajjDay13Desc": {
  "description": "Learning summary for 13 Dhul Hijjah"
},

"hajjDaysNote": "Treat this as an educational map, not as a substitute for your group leader, current official Hajj instructions or qualified religious guidance. In particular, timing, crowd-management concessions and penalties require situation-specific assessment.",
"@hajjDaysNote": {
  "description": "Disclaimer for the day-by-day Hajj guide"
},
"ihramRulesTitle": "Ihram Rules",
"@ihramRulesTitle": {
  "description": "Title of the Ihram rules guide"
},
"ihramRulesMenuDesc": "Learn what Ihram means and the main restrictions observed during Ihram.",
"@ihramRulesMenuDesc": {
  "description": "Navigation description for the Ihram rules guide"
},
"ihramRulesIntro": "Ihram is a state of worship entered for Hajj or Umrah, not simply a set of clothes. While in Ihram, some actions that are normally permitted become restricted. The consequences of a violation can differ according to the action, circumstances and school of law.",
"@ihramRulesIntro": {
  "description": "Introduction to the Ihram rules guide"
},
"ihramRulesTopicsTitle": "While in Ihram",
"@ihramRulesTopicsTitle": {
  "description": "Heading above Ihram rules topics"
},

"ihramRulesMeaningTitle": "Ihram Is a State of Worship",
"@ihramRulesMeaningTitle": {
  "description": "Title explaining the meaning of Ihram"
},
"ihramRulesMeaningDesc": "Ihram begins through the religious intention for Hajj or Umrah. In Hanafi teaching, intention and talbiyah together are integral to entering Ihram; other schools differ regarding the legal status of the talbiyah. Wearing Ihram clothing alone does not by itself explain the whole religious state.",
"@ihramRulesMeaningDesc": {
  "description": "Explanation that Ihram is a religious state"
},

"ihramRulesClothingTitle": "Clothing",
"@ihramRulesClothingTitle": {
  "description": "Title for clothing rules during Ihram"
},
"ihramRulesClothingDesc": "Clothing restrictions differ between men and women. Men in Ihram leave ordinary fitted clothing and use the customary izar and rida coverings. Women do not have a special two-piece Ihram garment and continue to observe their normal modest clothing requirements. Detailed cases involving coverings, medical supports or exceptional needs should be assessed separately.",
"@ihramRulesClothingDesc": {
  "description": "General explanation of clothing rules during Ihram"
},

"ihramRulesHairNailsTitle": "Hair and Nails",
"@ihramRulesHairNailsTitle": {
  "description": "Title for hair and nail restrictions during Ihram"
},
"ihramRulesHairNailsDesc": "Deliberately cutting or removing hair and cutting the nails are among the actions restricted during Ihram. Accidental breakage, medical necessity and the amount involved can affect the ruling, so this app does not calculate a penalty automatically.",
"@ihramRulesHairNailsDesc": {
  "description": "General explanation of hair and nail restrictions"
},

"ihramRulesFragranceTitle": "Fragrance and Grooming",
"@ihramRulesFragranceTitle": {
  "description": "Title for fragrance restrictions during Ihram"
},
"ihramRulesFragranceDesc": "Using fragrance for the purpose of perfuming oneself is restricted during Ihram. Grooming products applied for adornment can also involve Ihram rulings. Medicines, ointments and treatments used for genuine medical purposes are assessed differently.",
"@ihramRulesFragranceDesc": {
  "description": "General explanation of fragrance and grooming restrictions"
},

"ihramRulesCleanlinessTitle": "Bathing and Cleanliness",
"@ihramRulesCleanlinessTitle": {
  "description": "Title for cleanliness during Ihram"
},
"ihramRulesCleanlinessDesc": "Being in Ihram does not prevent bathing or performing ghusl. Unscented cleaning products are a simple precaution. The Presidency of Religious Affairs also distinguishes ordinary cleaning from deliberately applying fragrance.",
"@ihramRulesCleanlinessDesc": {
  "description": "Explanation that bathing is permitted during Ihram"
},

"ihramRulesIntimacyTitle": "Marital Intimacy",
"@ihramRulesIntimacyTitle": {
  "description": "Title for marital intimacy restrictions during Ihram"
},
"ihramRulesIntimacyDesc": "Sexual intercourse is among the serious restrictions associated with Ihram. During Hajj, some related restrictions can continue beyond the first release from Ihram until the required visitation tawaf is performed. Questions involving an actual incident require individual religious guidance.",
"@ihramRulesIntimacyDesc": {
  "description": "General explanation of marital intimacy restrictions during Ihram"
},

"ihramRulesPenaltyNote": "Do not use this screen to determine your own penalty. The result of an Ihram violation can depend on the act, amount, duration, intention or forgetfulness, necessity, type of Hajj and school of law.",
"@ihramRulesPenaltyNote": {
  "description": "Warning against automatically calculating penalties for Ihram violations"
},

"hajjSpecialCasesTitle": "Common Hajj & Umrah Situations",
"@hajjSpecialCasesTitle": {
  "description": "Title of the common Hajj and Umrah situations guide"
},
"hajjSpecialCasesMenuDesc": "Review common mistakes and situations that require more specific guidance.",
"@hajjSpecialCasesMenuDesc": {
  "description": "Navigation description for the common situations guide"
},
"hajjSpecialCasesIntro": "Some Hajj and Umrah questions cannot be answered safely with a single rule. This guide highlights common situations and explains when a person should stop relying on a general checklist and seek situation-specific guidance.",
"@hajjSpecialCasesIntro": {
  "description": "Introduction to common Hajj and Umrah situations"
},
"hajjSpecialCasesTopicsTitle": "Common Situations",
"@hajjSpecialCasesTopicsTitle": {
  "description": "Heading above common Hajj and Umrah situations"
},

"hajjSpecialMiqatTitle": "Crossing the Miqat Without Ihram",
"@hajjSpecialMiqatTitle": {
  "description": "Title for crossing the Miqat without Ihram"
},
"hajjSpecialMiqatDesc": "If a person intending Hajj or Umrah crosses the relevant miqat without entering Ihram, the next step depends on what has happened since then. Returning to a valid miqat before beginning the rites can affect the ruling. Do not guess a penalty from the app; seek guidance before continuing where possible.",
"@hajjSpecialMiqatDesc": {
  "description": "Guidance for accidentally crossing the Miqat without Ihram"
},

"hajjSpecialMenstruationTitle": "Menstruation or Postpartum Bleeding",
"@hajjSpecialMenstruationTitle": {
  "description": "Title for menstruation and postpartum situations"
},
"hajjSpecialMenstruationDesc": "Menstruation or postpartum bleeding does not prevent a woman from entering Ihram. Tawaf, however, has separate purity rulings, and the legal consequences differ between schools of law and according to the circumstances. Follow qualified guidance rather than treating the entire Hajj or Umrah as cancelled.",
"@hajjSpecialMenstruationDesc": {
  "description": "High-level guidance for menstruation or postpartum bleeding during Hajj or Umrah"
},

"hajjSpecialForgottenViolationTitle": "A Restriction Was Broken by Mistake",
"@hajjSpecialForgottenViolationTitle": {
  "description": "Title for forgotten or unknown Ihram violations"
},
"hajjSpecialForgottenViolationDesc": "Forgetfulness or not knowing the rule does not have one universal consequence. Hanafi, Maliki, Shafii and Hanbali rulings differ, and some schools distinguish between types of restrictions. Record what happened and seek qualified guidance rather than assuming either that nothing is required or that a penalty is definitely due.",
"@hajjSpecialForgottenViolationDesc": {
  "description": "Guidance for accidental or unknown Ihram violations"
},

"hajjSpecialMedicalNeedTitle": "Illness or Medical Need",
"@hajjSpecialMedicalNeedTitle": {
  "description": "Title for illness or medical necessity during Ihram"
},
"hajjSpecialMedicalNeedDesc": "Medical treatment should not be abandoned merely because a person is in Ihram. Medicines and treatment creams are treated differently from products used for adornment. If treatment requires an action that is normally restricted, the person should receive the needed care and then ask about any religious consequence separately.",
"@hajjSpecialMedicalNeedDesc": {
  "description": "Guidance for medical needs during Ihram"
},

"hajjSpecialCrowdingTitle": "Crowding, Age or Physical Difficulty",
"@hajjSpecialCrowdingTitle": {
  "description": "Title for crowding and physical difficulty"
},
"hajjSpecialCrowdingDesc": "Hajj rulings include concessions for genuine difficulty. For example, current Presidency of Religious Affairs guidance allows the visitation tawaf to be delayed because of severe crowding, old age or illness without automatically requiring a penalty. Follow official organisation instructions and qualified religious guidance for the actual situation.",
"@hajjSpecialCrowdingDesc": {
  "description": "Guidance for crowding age and physical difficulty during Hajj"
},

"hajjSpecialEarlyHaircutTitle": "Hair Was Cut Too Early",
"@hajjSpecialEarlyHaircutTitle": {
  "description": "Title for cutting hair before the appropriate stage"
},
"hajjSpecialEarlyHaircutDesc": "Cutting the hair does not always mean that a person has validly completed Hajj or Umrah or left Ihram. The result depends on which rites had already been completed and on the school of law. Do not simply continue as though the rites are finished; ask for situation-specific guidance.",
"@hajjSpecialEarlyHaircutDesc": {
  "description": "Guidance when hair was cut before the appropriate stage"
},

"hajjSpecialCasesNote": "This guide intentionally avoids assigning penalties. When a rite was missed, performed in the wrong order or affected by illness, menstruation, crowding or an Ihram violation, use current official guidance and a qualified religious adviser who can evaluate the complete situation.",
"@hajjSpecialCasesNote": {
  "description": "Disclaimer for special Hajj and Umrah situations"
