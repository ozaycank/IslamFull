"ramadanGuideTitle": "Ramadan Guide",
"@ramadanGuideTitle": {
  "description": "Title of the educational Ramadan guide screen"
},
"ramadanGuideMenuDesc": "Learn the essentials of fasting, sahur, iftar, Tarawih, fitra, Laylat al-Qadr and Eid.",
"@ramadanGuideMenuDesc": {
  "description": "Short description for links to the Ramadan guide"
},
"ramadanGuideIntro": "A concise reference for common Ramadan practices. Open a topic when you need it; the guide is for learning and reference, not for measuring worship.",
"@ramadanGuideIntro": {
  "description": "Introduction to the Ramadan educational guide"
},

"ramadanGuideFastingTitle": "Fasting in Ramadan",
"@ramadanGuideFastingTitle": {
  "description": "Ramadan guide topic about the basic meaning of fasting"
},
"ramadanGuideFastingDesc": "Fasting in Ramadan is obligatory for Muslims who meet the conditions of religious responsibility. The daily fast begins at imsak (true dawn) and continues until sunset. During this period, the fasting person abstains from eating, drinking and sexual relations with the intention of worship. Intention is a condition of the fast. Details concerning the timing of intention and valid exemptions can differ according to circumstances and schools of law.",
"@ramadanGuideFastingDesc": {
  "description": "Basic educational explanation of Ramadan fasting"
},
"ramadanGuideFastingSource": "Source: Din İşleri Yüksek Kurulu — Orucun Mahiyeti, Farzları, Sünnetleri ve Adabı.",
"@ramadanGuideFastingSource": {
  "description": "Source label for basic Ramadan fasting information"
},

"ramadanGuideSahurIftarTitle": "Sahur and Iftar",
"@ramadanGuideSahurIftarTitle": {
  "description": "Ramadan guide topic about sahur and iftar"
},
"ramadanGuideSahurIftarDesc": "Sahur is the meal eaten before imsak. The Prophet encouraged Muslims to eat sahur, and delaying it without entering a doubtful time is regarded as recommended practice. Once sunset and the iftar time have certainly begun, unnecessarily delaying the breaking of the fast is not recommended. Iftar does not require a particular food; commonly mentioned foods such as dates or water are recommendations rather than conditions.",
"@ramadanGuideSahurIftarDesc": {
  "description": "Educational information about sahur and iftar"
},
"ramadanGuideSahurIftarSource": "Source: Din İşleri Yüksek Kurulu — Sahur Yemeğinin Dindeki Önemi; Diyanet Oruç İlmihali.",
"@ramadanGuideSahurIftarSource": {
  "description": "Source label for sahur and iftar information"
},

"ramadanGuideBreaksFastTitle": "What Breaks the Fast?",
"@ramadanGuideBreaksFastTitle": {
  "description": "Ramadan guide topic about actions that may break the fast"
},
"ramadanGuideBreaksFastDesc": "Intentionally eating, drinking or having sexual relations during the fasting period breaks the fast. Eating or drinking because one genuinely forgot that one was fasting does not break it; once remembered, the person stops and continues the fast. Medical treatments, medicines, injections, dental procedures and accidental swallowing can involve more detailed rulings. Do not rely on a short general list for an individual medical or legal case.",
"@ramadanGuideBreaksFastDesc": {
  "description": "Carefully scoped overview of actions that break or do not break fasting"
},
"ramadanGuideBreaksFastSource": "Source: Din İşleri Yüksek Kurulu — Orucu Bozan ve Bozmayan Haller.",
"@ramadanGuideBreaksFastSource": {
  "description": "Source label for fasting validity information"
},

"ramadanGuideTarawihTitle": "Tarawih Prayer",
"@ramadanGuideTarawihTitle": {
  "description": "Ramadan guide topic about Tarawih prayer"
},
"ramadanGuideTarawihDesc": "Tarawih is a voluntary prayer associated with the nights of Ramadan. It is performed after the obligatory Isha prayer and may be prayed until the beginning of Fajr time. In the commonly taught Diyanet framework it is regarded as a strongly emphasised Sunnah for both women and men. It may be prayed individually or in congregation.",
"@ramadanGuideTarawihDesc": {
  "description": "Educational explanation of Tarawih prayer"
},
"ramadanGuideTarawihSource": "Source: Din İşleri Yüksek Kurulu — Teravih Namazının Hükmü ve Mahiyeti.",
"@ramadanGuideTarawihSource": {
  "description": "Source label for Tarawih information"
},

"ramadanGuideFitraFidyaTitle": "Fitra and Fidya",
"@ramadanGuideFitraFidyaTitle": {
  "description": "Ramadan guide topic explaining fitra and fidya"
},
"ramadanGuideFitraFidyaDesc": "Fitra (sadaqat al-fitr) is a financial act of worship connected with reaching Eid al-Fitr and helping those in need. Fidya is different: in the fasting context it applies principally when a person cannot fast and also has no realistic ability to make up the missed fasts, such as permanent illness or advanced age. The monetary amount is determined according to current conditions and can change over time, so the current official amount should be checked rather than relying on an old figure.",
"@ramadanGuideFitraFidyaDesc": {
  "description": "Educational distinction between fitra and fasting fidya"
},
"ramadanGuideFitraFidyaSource": "Source: Din İşleri Yüksek Kurulu — Fıtır Sadakası and Oruç Fidyesi guidance.",
"@ramadanGuideFitraFidyaSource": {
  "description": "Source label for fitra and fidya information"
},

"ramadanGuideLaylatQadrTitle": "Laylat al-Qadr",
"@ramadanGuideLaylatQadrTitle": {
  "description": "Ramadan guide topic about Laylat al-Qadr"
},
"ramadanGuideLaylatQadrDesc": "Laylat al-Qadr is a night within Ramadan described in the Quran as better than a thousand months. The Prophet encouraged Muslims to seek it during the last ten nights of Ramadan, especially the odd-numbered nights. The 27th night is widely observed, but the guide does not present it as a date known with absolute certainty. Quran recitation, prayer, remembrance, repentance and supplication are appropriate ways to spend these nights.",
"@ramadanGuideLaylatQadrDesc": {
  "description": "Educational explanation of Laylat al-Qadr without claiming a certain date"
},
"ramadanGuideLaylatQadrSource": "Source: Quran 97:1–5; Diyanet guidance on Laylat al-Qadr and the last ten nights of Ramadan.",
"@ramadanGuideLaylatQadrSource": {
  "description": "Source label for Laylat al-Qadr information"
},

"ramadanGuideEidTitle": "Eid al-Fitr",
"@ramadanGuideEidTitle": {
  "description": "Ramadan guide topic about Eid al-Fitr"
},
"ramadanGuideEidDesc": "Eid al-Fitr follows the completion of Ramadan. Eid prayer is performed in congregation; detailed legal classifications and some practices differ between schools of law. Fitra may be given before Eid and giving it before the Eid prayer is recommended so that those in need can share in the occasion.",
"@ramadanGuideEidDesc": {
  "description": "Educational explanation of Eid al-Fitr"
},
"ramadanGuideEidSource": "Source: Din İşleri Yüksek Kurulu — Fıtır Sadakası and guidance on congregational Eid prayer.",
"@ramadanGuideEidSource": {
  "description": "Source label for Eid al-Fitr information"
},

"ramadanGuideImportantNoteTitle": "When personal guidance is needed",
"@ramadanGuideImportantNoteTitle": {
  "description": "Heading for the Ramadan guide caution note"
},
"ramadanGuideImportantNote": "Health conditions, pregnancy, breastfeeding, travel, medicines and medical procedures can require individual assessment. For a personal health decision, consult a qualified healthcare professional; for a detailed religious ruling, consult a reliable religious authority. Differences between schools of law may also affect some details.",
"@ramadanGuideImportantNote": {
  "description": "Caution note for health, personal circumstances and school-specific rulings"
},
"ramadanGuideSourceNote": "Primary religious reference: Presidency of Religious Affairs (Diyanet) and the High Board of Religious Affairs. This screen is a concise learning guide and does not replace an individual fatwa.",
"@ramadanGuideSourceNote": {
  "description": "General source and scope note for Ramadan guidance"
},
"qurbanTitle": "Qurban",
"@qurbanTitle": {
  "description": "Title of the Qurban hub"
},
"qurbanIntro": "Learn the essential guidance for the udhiyah offered during Eid al-Adha, including eligibility, animals, shares, timing, proxy arrangements and distribution.",
"@qurbanIntro": {
  "description": "Introduction shown in the Qurban hub"
},
"qurbanScopeNote": "This section focuses on udhiyah offered during Eid al-Adha. Hajj-related hady, vows and other types of sacrifice have separate rulings.",
"@qurbanScopeNote": {
  "description": "Clarifies the scope of the Qurban hub"
},

"qurbanGuideTitle": "Qurban Guide",
"@qurbanGuideTitle": {
  "description": "Title of the Qurban religious guide"
},
"qurbanGuideMenuDesc": "Learn the essentials of udhiyah, eligible animals, shares, timing and proxy sacrifice.",
"@qurbanGuideMenuDesc": {
  "description": "Short description for Qurban guide navigation"
},
"qurbanGuideIntro": "A concise guide to the shared fundamentals of udhiyah during Eid al-Adha. Detailed rulings can differ between schools of law and personal circumstances.",
"@qurbanGuideIntro": {
  "description": "Introduction to the Qurban guide"
},
"qurbanGuideTopicsTitle": "Qurban Topics",
"@qurbanGuideTopicsTitle": {
  "description": "Heading above the Qurban guide topics"
},

"qurbanGuideMeaningTitle": "Meaning and Purpose",
"@qurbanGuideMeaningTitle": {
  "description": "Title of the meaning and purpose topic"
},
"qurbanGuideMeaningDesc": "Udhiyah is the sacrifice of an eligible animal during the specified days of Eid al-Adha as an act of worship seeking closeness to Allah. Its purpose is worship, gratitude and sharing rather than merely obtaining meat.",
"@qurbanGuideMeaningDesc": {
  "description": "Explanation of the meaning of udhiyah"
},

"qurbanGuideResponsibilityTitle": "Who Is Responsible?",
"@qurbanGuideResponsibilityTitle": {
  "description": "Title of the Qurban responsibility topic"
},
"qurbanGuideResponsibilityDesc": "The legal ruling differs among schools of law. In the Hanafi school, an adult, sane and resident Muslim who owns nisab beyond basic needs and debts is responsible for udhiyah. Most other jurists regard it as an emphasized Sunnah for those who are able to offer it.",
"@qurbanGuideResponsibilityDesc": {
  "description": "High-level explanation of who may be responsible for udhiyah"
},

"qurbanGuideAnimalsTitle": "Eligible Animals and Ages",
"@qurbanGuideAnimalsTitle": {
  "description": "Title of the eligible Qurban animals topic"
},
"qurbanGuideAnimalsDesc": "Udhiyah may be offered from sheep, goats, cattle, buffalo and camels. Based on lunar years, camels must normally be at least five years old, cattle and buffalo two, and sheep and goats one. A sheep that has completed six months may be eligible if it is as developed as a one-year-old sheep. The animal must also be healthy and free from defects that prevent its use for udhiyah.",
"@qurbanGuideAnimalsDesc": {
  "description": "Explanation of eligible animals, age limits and health requirements"
},

"qurbanGuideSharesTitle": "Shares and Joint Qurban",
"@qurbanGuideSharesTitle": {
  "description": "Title of the Qurban shares topic"
},
"qurbanGuideSharesDesc": "A sheep or goat is offered for one person. Cattle, buffalo and camels may be shared by up to seven people, provided that each person's share is at least one seventh. The participants must join with an intention of worship.",
"@qurbanGuideSharesDesc": {
  "description": "Explanation of individual and shared Qurban"
},

"qurbanGuideTimeTitle": "Time of Sacrifice",
"@qurbanGuideTimeTitle": {
  "description": "Title of the Qurban timing topic"
},
"qurbanGuideTimeDesc": "In the common Hanafi guidance used by the Presidency of Religious Affairs, the time for udhiyah begins after the Eid prayer on the first day and continues until sunset on the third day. In the Shafii school it may continue until sunset on the fourth day.",
"@qurbanGuideTimeDesc": {
  "description": "Explanation of the period in which udhiyah is offered"
},

"qurbanGuideProxyTitle": "Proxy and Donations",
"@qurbanGuideProxyTitle": {
  "description": "Title of the proxy Qurban topic"
},
"qurbanGuideProxyDesc": "A person may appoint another person or an organisation to purchase, sacrifice and distribute the animal on their behalf when the required proxy is given. Donating money without an eligible animal actually being sacrificed does not itself fulfil the udhiyah.",
"@qurbanGuideProxyDesc": {
  "description": "Explanation of proxy sacrifice and the distinction from ordinary donations"
},

"qurbanGuideMeatTitle": "Meat and Distribution",
"@qurbanGuideMeatTitle": {
  "description": "Title of the Qurban meat distribution topic"
},
"qurbanGuideMeatDesc": "Sharing the meat between one's household, relatives or neighbours and people in need is recommended. Detailed distribution rules differ between schools of law. Meat, skin or other parts of the animal should not be used as payment for the slaughtering service.",
"@qurbanGuideMeatDesc": {
  "description": "General guidance for distributing Qurban meat"
},

"qurbanGuideMisconceptionsTitle": "Common Misconceptions",
"@qurbanGuideMisconceptionsTitle": {
  "description": "Title of the common Qurban misconceptions topic"
},
"qurbanGuideMisconceptionsDesc": "Being unmarried does not prevent an eligible person from offering udhiyah. Shares in a large animal do not have to total an odd number such as three, five or seven. When an animal's age is reliably known, changing its front teeth is not an additional requirement.",
"@qurbanGuideMisconceptionsDesc": {
  "description": "Clarifies several common misconceptions about Qurban"
},

"qurbanGuideSchoolNote": "This guide provides shared fundamentals and brief orientation. Detailed rulings can vary by school of law, type of sacrifice and individual circumstances.",
"@qurbanGuideSchoolNote": {
  "description": "Madhhab and circumstance disclaimer for the Qurban guide"
},
"qurbanGuideSourceNote": "Religious guidance is based primarily on information published by the Presidency of Religious Affairs and the High Board of Religious Affairs.",
"@qurbanGuideSourceNote": {
  "description": "Source note for Qurban religious guidance"
},
