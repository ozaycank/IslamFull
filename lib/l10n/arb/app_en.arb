"duaWakeMeaning": "All praise is for Allah who gave us life after causing us to die, and to Him is the resurrection.",
"@duaWakeMeaning": {
  "description": "Meaning of the supplication upon waking"
},
"duaWakeSource": "Bukhari, Da'awat, 7",
"@duaWakeSource": {
  "description": "Hadith source for the supplication upon waking"
},

"duaSleepTitle": "Before Sleep",
